# SeedDrift configuration (copied to deploy/seeddrift.env on first use; that file is not tracked by git)

# where the reference data (about 60 GB of downloads, about 120 GB with indices) and the job folders live
SEEDDRIFT_DATA=$SD_ROOT/store
SEEDDRIFT_THREADS=16
# SD_TMP=/big/disk/tmp                     # temporary files (default: $SEEDDRIFT_DATA/tmp)

# service ports (all bound to 127.0.0.1; reach the API from your laptop with ./seeddrift.sh tunnel)
SD_API_PORT=8600
SD_TOOLS_PORT=8601
SD_ESMFOLD_PORT=8602
SD_API_HOST=127.0.0.1

# environments: micromamba prefix (created by ./seeddrift.sh install)
SD_MAMBA_ROOT=$SD_ROOT/.mamba
# MAMBA_EXE=/path/to/micromamba            # use an existing micromamba instead of downloading one
# SD_CONDA_MIRROR=tuna                     # conda-forge/bioconda from mirrors.tuna.tsinghua.edu.cn (mainland China)

# ESMFold: "conda" = own env with torch from PyPI (cu121); "system" = reuse the system python3 + torch
SD_ESMFOLD_TORCH=conda
CUDA_VISIBLE_DEVICES=0
SEEDDRIFT_FOLDSEEK_GPU=0                   # 1 with the foldseek linux-gpu build
# SEEDDRIFT_MMSEQS_GPU=/path/to/mmseqs     # MMseqs2 linux-gpu build for the deep search (install fetches it)
# SD_MMSEQS_GPU=off                        # do not fetch the MMseqs2 GPU build
# SEEDDRIFT_DIAMOND_BLOCK=auto             # DIAMOND -b,-c; auto picks by free memory (e.g. 8,1 above 300 GB)

# downloads (all happen on this machine)
# https_proxy=http://proxy:port
# HF_ENDPOINT=https://hf-mirror.com        # where huggingface.co is not reachable

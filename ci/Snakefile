# SeedDrift CI pipeline. Started only by `python -m ci run` (ci/__main__.py), which creates the run directory, writes
# config.resolved.yaml and the run record, and runs Snakemake with the run directory as working directory.
# Every rule calls one stage script; gate sentinels (gates/*.ok) are inputs of every later rule, so nothing runs
# before the gates pass. Gates are decided in every run (their outputs live in the run directory); a resume decides
# them again before Snakemake continues (ci/__main__.py).

import os

PY = config["tools"]["python"]
STAGE = PY + " -m ci.stages.{name} " + os.getcwd()


rule all:
    input:
        "gates/report.ok",
        "data/model/model.npz",


# pipeline select (profiles with `pipeline: select`; ci/__main__.py asks for this target): catalogue snapshots, the
# corpus selection, its gates, and its cost. The budget and fit stages do not wait for the selection gates, so a
# selection that fails them still comes with its report.
rule select_all:
    input:
        "gates/select.ok",
        "data/select/report.md",
        "data/select/fit.json",


# pipeline search (profiles with `pipeline: search`): the corpus, the evaluation inputs and the search, with their gates;
# no training. A later train run takes the search whole (search.reuse_from), which is exact only for the whole run.
rule search_all:
    input:
        "gates/corpus.ok",
        "gates/eval.ok",
        "data/hits/manifest.json",


# pipeline selfsup (profiles with `pipeline: selfsup`, the truth-labels line): corpus, search (usually reused whole),
# training data and the self-supervised model, then its own report: the held-out diagnosis and, with `islands:`, the
# development island chromosomes (prepared and searched beside the training, scored after it); no released screen and
# no scenario report (pipeline train)
ISLANDS = bool(config.get("islands"))
PAIRS = bool(config.get("pairs"))                         # objective C: the corpus searched against itself

rule selfsup_all:
    input:
        "gates/corpus.ok",
        "gates/eval.ok",
        "gates/selfsup.ok",
        "data/model/model.npz",


# pipeline codon (profiles with `pipeline: codon`, the truth-labels line): the codon-usage study on the island
# chromosomes of a passed run with panels from passed runs' training data (ci/stages/codon.py); no corpus, search or
# training of its own
rule codon_all:
    input: "gates/codon.ok"


rule codon_study:
    input: "gates/pre.ok"
    output: "data/codon/study.json"
    resources: gpu=1
    shell: STAGE.format(name="codon") + " study"


rule codon_report:
    input: "data/codon/study.json"
    output: "data/codon/report.json"
    shell: STAGE.format(name="codon") + " report"


rule gates_codon:
    input: "data/codon/report.json"
    output: "gates/codon.ok"
    shell: STAGE.format(name="gates") + " codon"


# pipeline register (profiles with `pipeline: register`): the register of the island reference set for benchmark v2
# (ci/stages/register.py, rule bench/hard/V2_REGISTER.md); metadata only
rule register_all:
    input: "gates/register.ok"


rule register:
    input: "gates/pre.ok"
    output: "data/register/report.json"
    shell: STAGE.format(name="register")


SEALED = bool((config.get("register") or {}).get("sealed"))       # the registry of everything sealed (ci/stages/sealed_registry.py)

rule sealed_registry:
    input: "gates/pre.ok"
    output: "data/register/sealed_registry.json"
    shell: STAGE.format(name="sealed_registry")


rule gates_register:
    input: ["data/register/report.json"] + (["data/register/sealed_registry.json"] if SEALED else [])
    output: "gates/register.ok"
    shell: STAGE.format(name="gates") + " register"


# pipeline audit (profiles with `pipeline: audit`): benchmark v2 M0, slim: the old island set's bias audit on its
# development chromosomes (ci/stages/audit.py)
rule audit_all:
    input: "gates/audit.ok"


rule audit_columns:
    input: "gates/pre.ok"
    output: "data/audit/columns.json"
    shell: STAGE.format(name="audit") + " columns"


rule audit_report:
    input: "data/audit/columns.json"
    output: "data/audit/report.json"
    shell: STAGE.format(name="audit") + " report"


rule gates_audit:
    input: "data/audit/report.json"
    output: "gates/audit.ok"
    shell: STAGE.format(name="gates") + " audit"


# pipeline family_a (profiles with `pipeline: family_a`): benchmark v2 family A re-cut on the development chromosomes
# (ci/stages/family_a.py, rules bench/hard/V2_FAMILY_A.md): GTDB, panels, outgroups, genomes (part 1); presence and
# labels (part 2)
rule famA_all:
    input: "gates/famA_taxa.ok", "gates/famA_labels.ok"


rule famA_taxa:
    input: "gates/pre.ok"
    output: "data/famA/taxa.json"
    shell: STAGE.format(name="family_a") + " taxa"


rule famA_fetch:
    input: "data/famA/taxa.json"
    output: "data/famA/fetch.json"
    shell: STAGE.format(name="family_a") + " fetch"


rule gates_famA_taxa:
    input: "data/famA/fetch.json"
    output: "gates/famA_taxa.ok"
    shell: STAGE.format(name="gates") + " famA_taxa"


# pipeline family_a_eval (profiles with `pipeline: family_a_eval`): units and evaluation of family A on the labels of
# a passed family_a run (ci/stages/family_a_eval.py, rules bench/hard/V2_FAMILY_A.md part 3)
rule famAe_all:
    input: "gates/famA_eval.ok"


rule famAe_units:
    input: "gates/pre.ok"
    output: "data/famA/units.json"
    resources: diamond=1
    shell: STAGE.format(name="family_a_eval") + " units"


rule famAe_eval:
    input: "data/famA/units.json"
    output: "data/famA/eval/report.json"
    shell: STAGE.format(name="family_a_eval") + " eval"


rule gates_famA_eval:
    input: "data/famA/eval/report.json"
    output: "gates/famA_eval.ok"
    shell: STAGE.format(name="gates") + " famA_eval"


rule famA_presence:
    input: "gates/famA_taxa.ok"
    output: "data/famA/presence/index.json"
    resources: diamond=1
    shell: STAGE.format(name="family_a") + " presence"


rule famA_labels:
    input: "data/famA/presence/index.json"
    output: "data/famA/labels/index.json"
    shell: STAGE.format(name="family_a") + " labels"


rule gates_famA_labels:
    input: "data/famA/labels/index.json"
    output: "gates/famA_labels.ok"
    shell: STAGE.format(name="gates") + " famA_labels"


rule pairs:
    input: "gates/corpus.ok"
    output: "data/pairs/manifest.json"
    resources: diamond=1
    shell: STAGE.format(name="pairs")


rule islands_data:
    input: ["gates/pre.ok", "data/reference/manifest.json"] + (["data/pairs/manifest.json"] if PAIRS else [])
    output: "data/islands/index.json"
    resources: diamond=1
    shell: STAGE.format(name="islands") + " data"


rule gates_islands:
    input: "data/islands/index.json", "data/corpus/manifest.json"      # G3_islands reads the corpus
    output: "gates/islands.ok"
    shell: STAGE.format(name="gates") + " islands"


rule islands_score:
    input: "gates/islands.ok", "data/model/model.npz", "data/islands/index.json"
    output: "data/islands/scores.json"
    resources: gpu=1
    shell: STAGE.format(name="islands") + " score"


rule islands_report:
    input: "data/islands/scores.json"
    output: "data/islands/contrasts.json"
    shell: STAGE.format(name="islands") + " report"


rule selfsup_report:
    input: ["data/model/model.npz"] + (["data/islands/contrasts.json"] if ISLANDS else [])
    output: "data/selfsup/report.json"
    shell: STAGE.format(name="selfsup_report")


rule gates_selfsup:
    input: "data/selfsup/report.json"
    output: "gates/selfsup.ok"
    shell: STAGE.format(name="gates") + " selfsup"


rule gates_pre:
    output: "gates/pre.ok"
    shell: STAGE.format(name="gates") + " pre"


rule catalog:
    input: "gates/pre.ok"
    output: "data/catalog/manifest.json"
    shell: STAGE.format(name="catalog")


rule select:
    input: "gates/pre.ok", "data/catalog/manifest.json"
    output: "data/select/selected.tsv", "data/select/candidates.tsv", "data/select/by_group.json", "data/select/manifest.json"
    shell: STAGE.format(name="select")


rule gates_select:
    input: "data/select/selected.tsv", "data/select/by_group.json", "data/select/manifest.json"
    output: "gates/select.ok"
    shell: STAGE.format(name="gates") + " select"


rule budget:
    input: "data/select/selected.tsv", "data/select/by_group.json"
    output: "data/select/rates.json", "data/select/budget.json", "data/select/report.md"
    shell: STAGE.format(name="budget")


rule fit:
    input: "data/select/budget.json"
    output: "data/select/fit.json"
    shell: STAGE.format(name="fit")


rule fetch:
    input: "gates/pre.ok"
    output: "data/fetch/manifest.json"
    shell: STAGE.format(name="fetch")


rule corpus:
    input: "gates/pre.ok", "data/fetch/manifest.json"
    output: "data/corpus/manifest.json"
    shell: STAGE.format(name="corpus")


rule gates_corpus:
    input: "data/corpus/manifest.json"
    output: "gates/corpus.ok"
    shell: STAGE.format(name="gates") + " corpus"


rule eval_inputs:
    input: "gates/pre.ok"
    output: "data/eval_inputs/manifest.json"
    shell: STAGE.format(name="eval_inputs")


rule reference:
    input: "gates/pre.ok"
    output: "data/reference/manifest.json", "data/reference/index.npz", "data/reference/library.npz"
    shell: STAGE.format(name="reference")


rule search:
    input: "gates/corpus.ok", "data/reference/manifest.json", "data/eval_inputs/manifest.json"
    output: "data/hits/manifest.json"
    resources: diamond=1
    shell: STAGE.format(name="search_or_reuse")


rule train_ids:
    input: "gates/corpus.ok"
    output: "data/train/ids.json"
    shell: STAGE.format(name="train") + " ids"


rule gates_train:
    input: "data/train/ids.json"
    output: "gates/train.ok"
    shell: STAGE.format(name="gates") + " train"


rule train_data:
    input: "gates/corpus.ok", "data/hits/manifest.json", "data/eval_inputs/manifest.json", "data/reference/manifest.json"
    output: "data/train_data/index.json"
    shell: STAGE.format(name="train_data_or_reuse")              # train_data.py, or its output of a run with the same key


rule train:
    input: ["gates/train.ok", "data/hits/manifest.json", "data/train_data/index.json"] + (["data/pairs/manifest.json"] if config.get("pairs") else [])
    output: "data/model/model.npz"
    resources: gpu=1
    shell: STAGE.format(name="train") + " fit"


rule gates_eval:
    input: "data/corpus/manifest.json", "data/eval_inputs/manifest.json"
    output: "gates/eval.ok"
    shell: STAGE.format(name="gates") + " eval"


rule released:
    input: "gates/eval.ok", "data/eval_inputs/manifest.json"
    output: "data/released/manifest.json"
    resources: diamond=1
    shell: STAGE.format(name="released")


rule eval:
    input: "gates/eval.ok", "data/model/model.npz", "data/hits/manifest.json", "data/eval_inputs/manifest.json", "data/released/manifest.json"
    output: "data/eval/eval_report.json"
    shell: STAGE.format(name="eval")


rule gates_report:
    input: "data/eval/eval_report.json"
    output: "gates/report.ok"
    shell: STAGE.format(name="gates") + " report"


# ---- the relational-model line: pipelines rel_* (configs/rel/kinds.yaml; ci/stages/rel/kinds.py) ----
# A rel profile names its kind (`pipeline: rel_tables`) and the stages it runs (rel.stages). Each stage's rule is in
# its package's file ci/rules/rel_<package>.smk (rule rel_<stage>, writing the output the registry names; every stage
# takes gates/pre.ok). This part adds the target rule, the gate rule of every stage (gates/rel_<stage>.ok) and the gate
# rule of the kind (gates/<kind>.ok). Nothing of the rules above changes.
import glob as _rel_glob
import yaml as _rel_yaml

with open(os.path.join(workflow.basedir, os.pardir, "configs", "rel", "kinds.yaml")) as _rel_f:
    REL = _rel_yaml.safe_load(_rel_f)
REL_STAGES = {_s: dict(_d, kind=_k) for _k, _kd in REL["kinds"].items() for _s, _d in _kd["stages"].items()}
REL_KIND = str(config.get("pipeline", "")) if str(config.get("pipeline", "")) in REL["kinds"] else ""
REL_ON = list((config.get("rel") or {}).get("stages") or []) if REL_KIND else []

for _rel_smk in sorted(_rel_glob.glob(os.path.join(workflow.basedir, "rules", "rel_*.smk"))):
    include: _rel_smk


rule rel_all:
    input: ["gates/%s.ok" % REL_KIND] if REL_KIND else []


rule gates_rel_kind:
    input: lambda wc: ["gates/rel_%s.ok" % s for s in REL_ON if REL_STAGES[s]["kind"] == wc.kind]
    output: "gates/{kind}.ok"
    wildcard_constraints: kind="|".join(sorted(REL["kinds"]))
    shell: STAGE.format(name="gates") + " {wildcards.kind}"


rule gates_rel_stage:
    input: lambda wc: REL_STAGES[wc.stage]["output"]
    output: "gates/rel_{stage}.ok"
    wildcard_constraints: stage="|".join(sorted(REL_STAGES))
    shell: STAGE.format(name="gates") + " rel_{wildcards.stage}"
